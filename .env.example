# Copy to .env and adjust. All variables are read by backend/app/config.py.
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5433/chatbot
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
# JSON list
CORS_ORIGINS=["http://localhost:5173"]
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_TEMPERATURE=0.2
OLLAMA_BASE_URL=http://localhost:11434
# Token budget for the history the model sees (the full history stays stored)
LLM_MAX_HISTORY_TOKENS=6000
# Ollama context window (tokens). LLM_MAX_HISTORY_TOKENS must be <= this minus 1500
OLLAMA_NUM_CTX=8192
# Max tool-calling rounds per message before the model must answer
AGENT_MAX_TOOL_ROUNDS=5
# Agent web_search tool: results per query and request timeout (seconds)
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10  # also the overall deadline for one search
# Keyless metasearch engine(s) used by ddgs (comma list allowed); 'auto' can be slow/flaky (includes unreachable engines)
WEB_SEARCH_BACKEND=duckduckgo,brave,yahoo,startpage
# Search the web before answering when a message needs facts newer than this year
AUTO_WEB_SEARCH=true
KNOWLEDGE_CUTOFF_YEAR=2024
# Used by tests only
TEST_DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5433/chatbot_test

# Document RAG: embeddings (Ollama by default), uploads and retrieval
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Sizes the vector column when the migration runs; changing it later needs `reindex`
EMBEDDING_DIMENSIONS=768
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=4
# Longer documents are marked failed instead of being embedded (500 ≈ 500 KB of text)
MAX_DOCUMENT_CHUNKS=500
# Search the user's documents before every answer, keeping passages this close (cosine distance)
AUTO_DOCUMENT_SEARCH=true
AUTO_DOCUMENT_MAX_DISTANCE=0.48
# Embedding task prefixes; unset = the model's default (nomic-embed-text: search_query: / search_document: )
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_DOCUMENT_PREFIX=

# MCP tool servers: JSON config (relative paths resolve against backend/; a missing file means none)
MCP_CONFIG_PATH=mcp_servers.json
# Deadline (seconds) for one MCP tool call, and for loading one server's tools at startup
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_STARTUP_TIMEOUT_SECONDS=20

# Copy to .env and adjust. All variables are read by backend/app/config.py.
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5433/chatbot
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
# JSON list
CORS_ORIGINS=["http://localhost:5173"]
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_TEMPERATURE=0.2
OLLAMA_BASE_URL=http://localhost:11434
# Token budget for the history the model sees (the full history stays stored)
LLM_MAX_HISTORY_TOKENS=6000
# Ollama context window (tokens). LLM_MAX_HISTORY_TOKENS must be <= this minus 1500
OLLAMA_NUM_CTX=8192
# Max tool-calling rounds per message before the model must answer
AGENT_MAX_TOOL_ROUNDS=5
# Agent web_search tool: results per query and request timeout (seconds)
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=10  # also the overall deadline for one search
# Keyless metasearch engine(s) used by ddgs (comma list allowed); 'auto' can be slow/flaky
WEB_SEARCH_BACKEND=bing
# Used by tests only
TEST_DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5433/chatbot_test
